{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HandCam scene (blockout)",
  "type": "object",
  "required": ["units", "spawn", "objects"],
  "properties": {
    "id": { "type": "string" },
    "prompt": { "type": "string" },
    "units": { "const": "m" },
    "spawn": {
      "type": "object",
      "required": ["p"],
      "properties": {
        "p": { "$ref": "#/$defs/vec3", "description": "camera start, eye height ~1.6" },
        "yaw": { "type": "number", "description": "radians, 0 = looking down -Z" }
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 60,
      "items": { "$ref": "#/$defs/object" }
    }
  },
  "$defs": {
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "object": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,32}$" },
        "type": { "enum": ["plane", "box", "cylinder", "sphere", "stickfigure"] },
        "label": { "type": "string", "maxLength": 40 },
        "p": { "$ref": "#/$defs/vec3" },
        "rot": { "$ref": "#/$defs/vec3", "description": "euler XYZ radians" },
        "size": { "type": "array", "items": { "type": "number", "minimum": 0.01 }, "minItems": 1, "maxItems": 3,
                  "description": "plane:[w,d] box:[w,h,d] cylinder:[r,h] sphere:[r]" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "height": { "type": "number", "minimum": 0.5, "maximum": 2.5, "description": "stickfigure only" },
        "pose": { "enum": ["standing", "sitting", "lying", "crouching"], "description": "stickfigure only" }
      },
      "additionalProperties": false
    }
  }
}
